{
  "name": "sologsb-1020-archive-reconciliation",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode ssr",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "verify": "esbuild scripts/verify-reconcile.ts --bundle --platform=node --format=esm --outfile=node_modules/.verify.mjs && node node_modules/.verify.mjs",
    "smoke:ssr": "vite build -c scripts/vite.smoke-build.config.ts >/dev/null 2>&1 && vite build -c scripts/vite.smoke-ssr.config.ts >/dev/null 2>&1 && node scripts/run-ssr-smoke.mjs; status=$?; rm -rf dist-smoke; exit $status"
  },
  "dependencies": {
    "@builder.io/qwik": "^1.20.1",
    "@qwik-ui/headless": "^0.7.7"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
